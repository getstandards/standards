{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getstandards.dev/schemas/v1/standards-lock.schema.json",
  "title": "Standards lock file",
  "description": "Version 1 of the .standards.lock format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceLock"
      }
    }
  },
  "$defs": {
    "mutableRevision": {
      "oneOf": [
        {
          "$ref": "https://getstandards.dev/schemas/v1/standards.schema.json#/$defs/tagRevision"
        },
        {
          "$ref": "https://getstandards.dev/schemas/v1/standards.schema.json#/$defs/branchRevision"
        }
      ]
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "commit"],
      "properties": {
        "repository": {
          "$ref": "https://getstandards.dev/schemas/v1/standards.schema.json#/$defs/httpsRepository"
        },
        "revision": {
          "$ref": "#/$defs/mutableRevision"
        },
        "commit": {
          "$ref": "https://getstandards.dev/schemas/v1/standards.schema.json#/$defs/commitId"
        }
      }
    }
  }
}
