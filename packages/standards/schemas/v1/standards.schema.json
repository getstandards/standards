{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "git": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://(?![^/]*@)"
                  },
                  "revision": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "commit": {
                            "type": "string",
                            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                          }
                        },
                        "required": [
                          "commit"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "tag": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "tag"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "branch": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "branch"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "repository",
                  "revision",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "git"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "level": {
            "type": "string",
            "enum": [
              "MUST",
              "MUST NOT",
              "SHOULD",
              "SHOULD NOT",
              "MAY"
            ]
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "applies_to": {
            "type": "object",
            "properties": {
              "include": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "guidance": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "level",
          "description",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "$id": "https://getstandards.dev/schemas/v1/standards.schema.json",
  "title": "Standards configuration",
  "description": "Version 1 of the .standards.yml configuration format."
}
